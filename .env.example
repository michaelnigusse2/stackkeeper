# Copy to .env and change BETTER_AUTH_SECRET. The rest works as-is with the
# Postgres that docker-compose.yml starts. Never commit .env.

# ---------------------------------------------------------------------------
# Database
#
# Three roles, deliberately. The application connects as stackkeeper_app,
# which owns nothing and cannot bypass row-level security, so a mistake in
# application code cannot read another workspace's rows. Migrations and
# maintenance use the owner. Better Auth has its own connection again.
#
# These passwords are for local development only. Change them for anything
# that is reachable from outside your machine.
# ---------------------------------------------------------------------------

# If you already have Postgres installed, it is probably on 5432 and will win
# the port. Set this to 5433 and change the three URLs below to match.
POSTGRES_PORT=5432

POSTGRES_PASSWORD=stackkeeper
APP_DB_PASSWORD=stackkeeper_app

# Used by every request. Least privilege.
DATABASE_URL=postgres://stackkeeper_app:stackkeeper_app@localhost:5432/stackkeeper

# Migrations, the worker and maintenance. Owns the tables.
DATABASE_ADMIN_URL=postgres://stackkeeper:stackkeeper@localhost:5432/stackkeeper

# Better Auth's own tables. Give it its own role in production.
AUTH_DATABASE_URL=postgres://stackkeeper:stackkeeper@localhost:5432/stackkeeper

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# REQUIRED. Generate one:
#   openssl rand -base64 32
#   (PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256})))
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# For passkeys, once that plugin is added back. Unused today.
# PASSKEY_RP_ID=localhost

# ---------------------------------------------------------------------------
# Monitoring and alerts
# ---------------------------------------------------------------------------

# Seals the few values that authenticate this service to somewhere else: a
# Slack or Discord webhook URL, a Telegram bot token. Not user credentials;
# Stackkeeper stores none of those. Falls back to BETTER_AUTH_SECRET if unset.
#   openssl rand -base64 32
# STACKKEEPER_SECRET_KEY=

# Email delivery. Without a key, alerts still appear in the application but no
# email is sent.
# RESEND_API_KEY=
# ALERT_FROM_EMAIL=Stackkeeper <alerts@yourdomain.com>

# Daily exchange rates, so margins are right when you pay in one currency and
# bill in another. Any endpoint returning {"base":"USD","rates":{...}} works.
# FX_RATES_URL=https://open.er-api.com/v6/latest/USD
